{
  "name": "frogie",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --parallel dev:server dev:web",
    "dev:server": "bun run --cwd packages/server dev",
    "dev:web": "bun run --cwd packages/web dev",
    "build": "bun run --parallel build:server build:web",
    "build:server": "bun run --cwd packages/server build",
    "build:web": "bun run --cwd packages/web build",
    "typecheck": "bun run typecheck:server && bun run typecheck:web",
    "typecheck:server": "node_modules/@typescript/native/bin/tsc --noEmit -p packages/server/tsconfig.json",
    "typecheck:web": "node_modules/@typescript/native/bin/tsc --noEmit -p packages/web/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:l2": "vitest run packages/server/src/routes/",
    "test:l3": "playwright test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "5.0.1",
    "bun-types": "1.4.2",
    "eslint": "10.11.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "30.1.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0"
    ]
  },
  "overrides": {
    "@hono/node-server": "^2.0.5",
    "body-parser": ">=2.3.0",
    "brace-expansion": ">=5.0.9",
    "fast-uri": "^3.1.6",
    "hono": "4.13.8",
    "ip-address": "10.7.2",
    "nanoid": "3.3.18",
    "postcss": ">=8.5.25",
    "qs": ">=6.16.0",
    "undici": "^8.9.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express-rate-limit": "8.7.0",
    "hono": "4.13.8",
    "ip-address": "10.7.2"
  },
  "engines": {
    "node": ">=22"
  }
}
