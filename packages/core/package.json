{
  "name": "@frogie/core",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "exports": {
    "./definitions": {
      "frogie-source": {
        "types": "./src/definitions/index.ts",
        "default": "./src/definitions/index.ts"
      },
      "types": "./dist/definitions/index.d.ts",
      "import": "./dist/definitions/index.js"
    },
    "./workflows": {
      "frogie-source": {
        "types": "./src/definitions/serializeWorkflow.ts",
        "default": "./src/definitions/serializeWorkflow.ts"
      },
      "types": "./dist/definitions/serializeWorkflow.d.ts",
      "import": "./dist/definitions/serializeWorkflow.js"
    },
    "./protocol": {
      "frogie-source": {
        "types": "./src/protocol/index.ts",
        "default": "./src/protocol/index.ts"
      },
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js"
    },
    "./runtime": {
      "frogie-source": {
        "types": "./src/runtime/index.ts",
        "default": "./src/runtime/index.ts"
      },
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./host": {
      "frogie-source": {
        "types": "./src/host/index.ts",
        "default": "./src/host/index.ts"
      },
      "types": "./dist/host/index.d.ts",
      "import": "./dist/host/index.js"
    },
    "./testing": {
      "frogie-source": {
        "types": "./src/testing/index.ts",
        "default": "./src/testing/index.ts"
      },
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./hisfm": {
      "frogie-source": {
        "types": "./src/squads/hisfm.ts",
        "default": "./src/squads/hisfm.ts"
      },
      "types": "./dist/squads/hisfm.d.ts",
      "import": "./dist/squads/hisfm.js"
    },
    "./hisfm/prompts": {
      "types": "./dist/squads/hisfm-prompts.d.ts",
      "import": "./dist/squads/hisfm-prompts.js"
    },
    "./hisfm/narration": {
      "types": "./dist/squads/hisfm-narration.d.ts",
      "import": "./dist/squads/hisfm-narration.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@earendil-works/pi-durable": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/chord": "1.1.0",
    "typebox": "1.3.27",
    "yaml": "2.9.1"
  },
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0"
  },
  "files": [
    "dist",
    "squads",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/build-core.mjs"
  }
}
